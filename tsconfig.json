{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "lib": ["ES2015"],
        "sourceMap": false,
        "declaration": false,
        "declarationMap": false,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": false,
        "module": "ES2015",
        "target": "ES2015",
        "esModuleInterop": true,
        "removeComments": true
    },
    "include": ["src/**/*"]
}
