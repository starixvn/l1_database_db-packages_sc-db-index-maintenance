{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "module": "ES2020",
        "target": "ES2020",
        "moduleResolution": "node",
        "strict": true,
        "declaration": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "removeComments": true,
        "preserveConstEnums": true
    },
    "include": ["src/**/*"],
}
